// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite" //mudar para postgres depois
}


model User {
  id       String    @id @default(uuid())
  email    String    @unique
  name     String
  telefone String?
  password String
  produtos Product[]
  pedidos   Pedido[]

  @@map("usuarios")
}

model Category {
  id       String    @id @default(uuid())
  nome     String
  produtos Product[]

  @@map("categorias")
}

model Product {
  id          String @id @default(uuid())
  vendedor_id String
  categoria_id String
  titulo      String
  descricao   String
  preco       Decimal 
  disponivel   Boolean @default(true)
  vendedor    User   @relation(fields: [vendedor_id], references: [id])
  categoria   Category @relation(fields: [categoria_id], references: [id])

  @@map("produtos")
}


model Pedido {
  id        String @id @default(uuid())
  comprador_id String
  status Boolean @default(false) 
  data_compra DateTime @default(now())
  valor_total Decimal // mudar valor total para associar ao carrinho posteriormente 
  comprador User @relation(fields: [comprador_id], references: [id])
  


  @@map("pedidos")
}












