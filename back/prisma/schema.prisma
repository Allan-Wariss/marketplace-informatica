// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite" //mudar para postgres depois
}



model User {
  id       String    @id @default(uuid())
  email    String    @unique
  name     String
  telefone String?
  password String
  produtos Product[]
  pedidos  Pedido[]
  carrinho Carrinho?

  @@map("usuarios")
}

model Category {
  id       String    @id @default(uuid())
  nome     String
  produtos Product[]

  @@map("categorias")
}

model Product {
  id           String         @id @default(uuid())
  vendedor_id  String
  categoria_id String
  titulo       String
  descricao    String
  preco        Decimal
  disponivel   Boolean        @default(true)
  imagem       String?
  vendedor     User           @relation(fields: [vendedor_id], references: [id])
  categoria    Category       @relation(fields: [categoria_id], references: [id])
  carrinhoItens CarrinhoItem[]

  @@map("produtos")
}


model Pedido {
  id           String   @id @default(uuid())
  comprador_id String
  carrinho_id  String   @unique
  finalizado   Boolean  @default(false)
  data_compra  DateTime @default(now())
  valor_total  Decimal
  comprador    User     @relation(fields: [comprador_id], references: [id])
  carrinho     Carrinho @relation(fields: [carrinho_id], references: [id])

  @@map("pedidos")
}

model Carrinho {
  id          String         @id @default(uuid())
  usuario_id  String         @unique
  valor_total Decimal        @default(0)
  usuario     User           @relation(fields: [usuario_id], references: [id])
  itens       CarrinhoItem[]
  pedido      Pedido?

  @@map("carrinhos")
}

model CarrinhoItem {
  id          String   @id @default(uuid())
  carrinho_id String
  produto_id  String
  quantidade  Int      @default(1)
  carrinho    Carrinho @relation(fields: [carrinho_id], references: [id])
  produto     Product  @relation(fields: [produto_id], references: [id])

  @@map("carrinho_itens")
}
